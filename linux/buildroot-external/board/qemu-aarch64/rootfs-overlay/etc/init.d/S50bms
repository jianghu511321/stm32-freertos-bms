#!/bin/sh

case "$1" in
  start)
    modprobe can
    modprobe can_raw
    modprobe vcan
    ip link add dev vcan0 type vcan 2>/dev/null || true
    ip link set up vcan0
    modprobe bms_can_monitor
    echo "BMS SocketCAN demo ready on vcan0"
    ;;
  stop)
    modprobe -r bms_can_monitor 2>/dev/null || true
    ip link del vcan0 2>/dev/null || true
    ;;
esac

